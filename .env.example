# =====================================================================
# CONFIGURACIÓN DE BASE DE DATOS Y ENTORNO CLOUD (SUPABASE + RENDER)
# =====================================================================

# URL de conexión a Supabase PostgreSQL:
# Obtenla en: https://supabase.com > Tu Proyecto > Project Settings > Database > Connection String > URI
# Recomendado: Usa el "Connection Pooler" (puerto 6543) para Streamlit y Render:
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Concurrencia de trabajadores en paralelo para scraping acelerado (por defecto: 6)
MAX_PARALLEL_WORKERS=6

# Entorno (development / production)
ENVIRONMENT=production
